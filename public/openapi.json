{
  "openapi": "3.0.3",
  "info": {
    "title": "Mohamed Tarek Abdelhady Portfolio API",
    "description": "Engineering tools, calculators, and portfolio API with MPP payment discovery.",
    "version": "1.0.0",
    "contact": {
      "name": "Mohamed Tarek Abdelhady",
      "url": "https://mohamed-tarek-abdelhady.vercel.app/"
    }
  },
  "servers": [
    {
      "url": "https://mohamed-tarek-abdelhady.vercel.app",
      "description": "Production (primary canonical)"
    },
    {
      "url": "https://website-mohamed.vercel.app",
      "description": "Production (secondary domain — same deployment)"
    }
  ],
  "paths": {
    "/api/x402": {
      "get": {
        "operationId": "getPremiumResource",
        "summary": "Access premium API resource",
        "description": "Returns premium content. Payment may be required via x402.",
        "x-payment-info": {
          "intent": "charge",
          "method": "lightning",
          "amount": "1000",
          "currency": "USD",
          "description": "Premium API resource access"
        },
        "responses": {
          "200": {
            "description": "Resource returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "resource": { "type": "string" }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Payment required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Payment requirements per x402 protocol"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "operationId": "getHomepage",
        "summary": "Portfolio homepage",
        "description": "Main portfolio page — free, no payment required.",
        "responses": {
          "200": { "description": "Homepage HTML" }
        }
      }
    },
    "/sites/ohms-law-calculator.html": {
      "get": {
        "operationId": "ohmsLawCalculator",
        "summary": "Ohm's Law Calculator",
        "description": "Calculate voltage, current, resistance, or power using Ohm's Law.",
        "x-payment-info": {
          "intent": "charge",
          "method": "tempo",
          "amount": "100",
          "currency": "USD",
          "description": "Ohm's Law calculator computation"
        },
        "responses": {
          "200": { "description": "Calculator page" }
        }
      }
    },
    "/sites/voltage-divider-calculator.html": {
      "get": {
        "operationId": "voltageDividerCalculator",
        "summary": "Voltage Divider Calculator",
        "description": "Solve Vout, R1 or R2 with optional load, power and E12 suggestions.",
        "responses": {
          "200": { "description": "Calculator page" }
        }
      }
    },
    "/sites/555-timer-calculator.html": {
      "get": {
        "operationId": "timer555Calculator",
        "summary": "555 Timer Calculator",
        "description": "Astable frequency/duty and monostable pulse width for NE555.",
        "responses": {
          "200": { "description": "Calculator page" }
        }
      }
    },
    "/sites/pcb-trace-width-calculator.html": {
      "get": {
        "operationId": "pcbTraceCalculator",
        "summary": "PCB Trace Width Calculator",
        "description": "IPC-2221 trace width, resistance, drop and via sizing.",
        "responses": {
          "200": { "description": "Calculator page" }
        }
      }
    },
    "/sites/decibel-dbm-calculator.html": {
      "get": {
        "operationId": "decibelDbmCalculator",
        "summary": "dB dBm Calculator",
        "description": "Ratios to dB, dBm to power/voltage, cascade gain.",
        "responses": {
          "200": { "description": "Calculator page" }
        }
      }
    },
    "/sites/op-amp-gain-calculator.html": {
      "get": {
        "operationId": "opAmpGainCalculator",
        "summary": "Op-Amp Gain Calculator",
        "description": "Inverting, non-inverting, differential and follower gain with clipping check.",
        "responses": {
          "200": { "description": "Calculator page" }
        }
      }
    },
    "/sites/battery-solar-calculator.html": {
      "get": {
        "operationId": "batterySolarCalculator",
        "summary": "Battery Life and Solar Calculator",
        "description": "Battery runtime plus solar panel and battery sizing.",
        "responses": {
          "200": { "description": "Calculator page" }
        }
      }
    }
  },
  "x-service-info": {
    "categories": ["engineering", "calculators", "portfolio"],
    "payment_methods": ["lightning", "tempo"]
  }
}
